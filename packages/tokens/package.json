{
  "name": "@rodium-labs/tokens",
  "version": "0.1.1",
  "type": "module",
  "description": "Design tokens for the Rodium Labs surface: colour, type, motion and the ground.",
  "license": "MIT",
  "author": "Rodium Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodium-labs/ui-kit.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/rodium-labs/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/rodium-labs/ui-kit/issues"
  },
  "keywords": [
    "design-tokens",
    "css",
    "tailwind",
    "tailwindcss",
    "theme"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "development": "./src/theme.css",
      "default": "./dist/theme.css"
    },
    "./base.css": {
      "development": "./src/base.css",
      "default": "./dist/base.css"
    },
    "./surface.css": {
      "development": "./src/surface.css",
      "default": "./dist/surface.css"
    },
    "./index.css": {
      "development": "./src/index.css",
      "default": "./dist/index.css"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
