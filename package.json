{
  "name": "rodium-ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "build": "bun run --cwd apps/playground build",
    "preview": "bun run --cwd apps/playground preview",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "typescript": "^5.9.3"
  }
}
