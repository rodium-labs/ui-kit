{
  "name": "rodium-ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The design system behind rodiumlabs.org: tokens, components and a docs site.",
  "license": "MIT",
  "author": "Rodium Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodium-labs/ui-kit.git"
  },
  "homepage": "https://github.com/rodium-labs/ui-kit",
  "bugs": {
    "url": "https://github.com/rodium-labs/ui-kit/issues"
  },
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "build": "bun run --cwd apps/playground build",
    "preview": "bun run --cwd apps/playground preview",
    "check": "biome check . && node tools/check-tokens.mjs",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --build --force",
    "check:tokens": "node tools/check-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "typescript": "^5.9.3"
  }
}
